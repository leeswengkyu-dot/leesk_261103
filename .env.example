# ARGUS-K 환경 변수. 로컬은 이 파일을 .env.local 로 복사해서 사용하고, Vercel 에서는 같은 이름으로 환경변수를 등록하세요.

# Postgres 연결 문자열 (Supabase: Connect → Transaction pooler, 포트 6543).
# 비워 두면 로컬 파일 DB(PGLITE_DIR)를 씁니다. Vercel 배포에서는 필수
DATABASE_URL=
# 로컬 파일 DB 경로 (DATABASE_URL 이 없을 때)
PGLITE_DIR=./data/pglite

# 포트 (HOST 는 npm run start:local / start:lan 이 정함)
PORT=3000

# 공유 모드(start:lan)와 Vercel 배포에서 필수. 6자리 이상. 쓰기 작업에 필요한 공유 PIN
EDIT_PIN=
# Vercel Cron 인증용 임의의 긴 문자열 (배포 시 필수)
CRON_SECRET=

# Claude API (없으면 AI 없이 키워드 규칙 + CSV 사전 생성 요약만 사용)
ANTHROPIC_API_KEY=
# 사용할 모델 ID (예: claude-sonnet-5-5)
AI_MODEL=

# 지도 배경(CARTO Voyager) API 키. https://carto.com/basemaps/apikey 에서 무료 발급.
# 브라우저에 노출되는 공개용 키이며 빌드 시점에 반영됨(바꾸면 재배포 필요). 비우면 OpenStreetMap 기본 지도 사용
NEXT_PUBLIC_CARTO_KEY=

# 하루 AI 호출 상한 / 수집 1회당 AI 처리 기사 수
AI_DAILY_LIMIT=300
AI_BATCH_LIMIT=100

# 실시간 자동 수집 간격(분). 상황판이 열려 있는 동안 반복 수집. 0 이면 끔
LIVE_INTERVAL_MIN=10
