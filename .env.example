# ARGUS-K 환경 변수. 이 파일을 .env.local 로 복사해서 사용하세요.

# DB 파일 경로 (개발용 DB: ./data/argus-dev.db)
DB_PATH=./data/argus.db

# 포트 (HOST 는 npm run start:local / start:lan 이 정함)
PORT=3000

# 내부망 공유 모드(start:lan)에서 필수. 6자리 이상. 쓰기 작업에 필요한 공유 PIN
EDIT_PIN=

# Claude API (없으면 AI 없이 키워드 규칙 + CSV 사전 생성 요약만 사용)
ANTHROPIC_API_KEY=
# 사용할 모델 ID (예: claude-sonnet-5-5)
AI_MODEL=

# 하루 AI 호출 상한 / 수집 1회당 AI 처리 기사 수
AI_DAILY_LIMIT=300
AI_BATCH_LIMIT=100

# 자동 수집 시각 (cron 식, Asia/Seoul 기준)
COLLECT_CRON=0 7 * * *

# 실시간 자동 수집 간격(분). 서버가 켜져 있는 동안 반복 수집. 0 이면 끔
LIVE_INTERVAL_MIN=10
